APP_NAME=Bangladesh National Vehicle Platform
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./vehicle_platform.db
DEFAULT_SPEED_LIMIT_KPH=80
OVERSPEED_TOLERANCE_KPH=5
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=bnvp-ingestion-api
KAFKA_TRACKING_PACKETS_TOPIC=tracking.packet.valid.v1
KAFKA_TRACKING_PACKETS_DLQ_TOPIC=tracking.packet.dead-letter.v1
KAFKA_TELEMETRY_CONSUMER_GROUP=bnvp-telemetry-storage-v1
KAFKA_CONSUMER_MAX_RETRIES=5
KAFKA_CONSUMER_RETRY_DELAY_SECONDS=2
TELEMETRY_MAX_BATCH_SIZE=500
TELEMETRY_MAX_REQUEST_BYTES=5242880
TELEMETRY_ALLOW_UNAUTHENTICATED_TEST=false

CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=bnvp_tracking
CLICKHOUSE_SECURE=false
CLICKHOUSE_CONNECT_TIMEOUT_SECONDS=10
CLICKHOUSE_SEND_RECEIVE_TIMEOUT_SECONDS=30
CLICKHOUSE_HISTORY_TABLE=vehicle_position_history

JWT_SECRET_KEY=development-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

ALLOW_PUBLIC_REGISTRATION=true
PUBLIC_REGISTRATION_AUTO_ACTIVATE=true

OWNER_PASSWORD_RESET_OTP_EXPIRE_MINUTES=5
OWNER_PASSWORD_RESET_OTP_COOLDOWN_SECONDS=60
OWNER_PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

# Development/testing simulates SMS and returns development_otp in the API response.
# Production requires a compatible JSON webhook receiving: to, message, sender_id.
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=BNVP

BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_FULL_NAME=Platform Super Admin
