# Copy this file to deployment/deploy.env on the live server.
# deployment/deploy.env is ignored by Git and survives production code updates.

# Git and application
BRANCH=main
SERVICE_NAME=vehicle-platform
CONSUMER_SERVICE_NAME=vehicle-platform-telemetry-consumer
NGINX_SITE_NAME=vehicle-platform

# Leave APP_DIR empty to use the repository root containing this deployment folder.
APP_DIR=

# Leave these empty to auto-detect the repository owner / sudo user.
DEPLOY_USER=
APP_USER=
APP_GROUP=

# Python / Uvicorn
VENV_DIR=.venv
APP_HOST=127.0.0.1
APP_PORT=8000
# PostgreSQL is used in production. Two API workers provide safe initial
# concurrency without consuming excessive memory on the current VPS.
UVICORN_WORKERS=2

# Public Nginx endpoint
SERVER_NAME=169.58.78.84
CLIENT_MAX_BODY_SIZE=25m
DISABLE_DEFAULT_NGINX_SITE=true

# Deployment health check
HEALTHCHECK_URL=http://127.0.0.1:8000/health
HEALTHCHECK_RETRIES=30
HEALTHCHECK_DELAY_SECONDS=2

# Set true only when code is updated outside Git by another deployment system.
SKIP_GIT_PULL=false
