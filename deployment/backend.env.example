# Copy to backend/.env on the server. Keep this file private.
APP_NAME=Bangladesh National Vehicle Platform
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
PUBLIC_WEB_URL=https://example.com
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@127.0.0.1:5432/bnvp
CORS_ORIGINS=["https://example.com"]
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
PUBLIC_REGISTRATION_AUTO_ACTIVATE=false
SMS_GATEWAY_URL=https://your-sms-gateway.example/send
SMS_GATEWAY_API_KEY=replace-me
SMS_SENDER_ID=BNVP
# Set true when Kafka and ClickHouse telemetry ingestion is ready.
TELEMETRY_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=bnvp_tracking
TELEMETRY_ALLOW_UNAUTHENTICATED_TEST=false
