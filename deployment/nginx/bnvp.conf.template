server {
    listen 80;
    listen [::]:80;
    server_name {{SERVER_NAME}};

    client_max_body_size {{CLIENT_MAX_BODY_SIZE}};

    location ^~ /api/ {
        proxy_pass http://{{API_HOST}}:{{API_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location = /health {
        proxy_pass http://{{API_HOST}}:{{API_PORT}}/health;
        proxy_set_header Host $host;
        access_log off;
    }

    location = /openapi.json { proxy_pass http://{{API_HOST}}:{{API_PORT}}/openapi.json; }
    location = /docs { proxy_pass http://{{API_HOST}}:{{API_PORT}}/docs; }
    location = /redoc { proxy_pass http://{{API_HOST}}:{{API_PORT}}/redoc; }

    location / {
        proxy_pass http://{{WEB_HOST}}:{{WEB_PORT}};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
