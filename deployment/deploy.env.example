# Copy to deployment/deploy.env on the server and set the real values.
# This file is server-only and is not committed.

# Pull the configured branch before deploying. Set false only when code is
# copied to the server by another release mechanism.
UPDATE_FROM_GIT=true
BRANCH=main

# Leave empty to use the account that ran sudo / owns the repository.
APP_USER=
APP_GROUP=

# Services and ports (kept private; Nginx is the public entry point).
API_SERVICE_NAME=bnvp-api
WEB_SERVICE_NAME=bnvp-web
CONSUMER_SERVICE_NAME=bnvp-telemetry-consumer
NGINX_SITE_NAME=bnvp
API_HOST=127.0.0.1
API_PORT=8000
WEB_HOST=127.0.0.1
WEB_PORT=3000
UVICORN_WORKERS=2

# The telemetry consumer depends on Kafka and ClickHouse. Keep it disabled
# until those services are configured; telemetry code remains in the project.
ENABLE_TELEMETRY_CONSUMER=false

# Public hostname or IP. Use _ only if this server must answer every hostname.
SERVER_NAME=portal.autogenerationbd.com
CLIENT_MAX_BODY_SIZE=25m
DISABLE_DEFAULT_NGINX_SITE=true

# Set true only after a Let's Encrypt certificate exists for SERVER_NAME.
TLS_ENABLED=false

# Commands discovered during installation. Change only when Node/pnpm is in a
# non-standard location for the APP_USER.
PNPM_BIN=pnpm

# Health checks
HEALTHCHECK_RETRIES=30
HEALTHCHECK_DELAY_SECONDS=2
